<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a1a">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simple Push"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:background="#252525"
        android:padding="20dp" />

    <!-- Карточка статуса -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#252525"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Инициализация..."
            android:textSize="18sp"
            android:textColor="#E0E0E0"
            android:gravity="center" />

    </LinearLayout>

    <!-- Кнопка получения ссылки -->
    <Button
        android:id="@+id/getLinkButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Получить ссылку"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="#333333"
        android:layout_marginBottom="16dp" />

    <!-- Информация о приложении -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Приложение автоматически регистрируется на сервере и получает ссылки для открытия в браузере."
        android:textSize="14sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_marginTop="32dp" />

</LinearLayout>
